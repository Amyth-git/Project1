# Application
APP_NAME=project1
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
API_KEY=change-me-in-production

# Docker image (CI/CD)
IMAGE_NAME=project1-api
IMAGE_TAG=local

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Alertmanager (optional Slack)
ALERTMANAGER_SLACK_WEBHOOK_URL=

# AWS / Terraform
AWS_REGION=us-east-1
PROJECT_NAME=project1
ENVIRONMENT=staging
